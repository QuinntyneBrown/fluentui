@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
 BorderColor #344054
 FontColor #101828
}
skinparam package {
 BorderColor #667085
 FontColor #101828
 BackgroundColor #F9FAFB
}
skinparam maxMessageSize 80
title Behavior - Classify failures and tracked debt
actor "Maintainer" as actor
box "Backend - Local tooling process (not a service)" #FFF4E5
participant "cli" as cli
participant "loadConfig / selectFixtures" as config
participant "BundleIsolationPlugin" as analysis
participant "createReport / classify" as report
end box
actor -> report : Supply fixture results and policy [L2-030]
report -> report : Compare found packages with exact allowlist
alt Error / regression / stale / orphan
report --> actor : FAIL, exit 1 [L2-031]
else Only tolerated leaks
alt strict=true
report --> actor : FAIL, exit 1
else strict=false
report --> actor : PASS WITH DEBT, exit 0
end
else No violations
report --> actor : PASS, exit 0
end
@enduml
