@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
 BorderColor #344054
 FontColor #101828
}
skinparam package {
 BorderColor #667085
 FontColor #101828
 BackgroundColor #F9FAFB
}
skinparam maxMessageSize 80
title Behavior - Record public API changes
actor "Maintainer" as actor
box "Backend - Local tooling process (not a service)" #FFF4E5
participant "Package manifest" as manifest
participant "generate-api executor" as api
participant "verify-packaging executor" as verify
participant "Isolated consumer fixture" as consumer
end box
actor -> api : Run applicable generate-api target [L2-028]
api -> manifest : Select stable and unstable entry points
manifest --> api : Public API inputs
api --> actor : API documentation diff
actor -> verify : Check package file list
verify -> manifest : Inspect npm pack --dry-run output
manifest --> verify : File listing and publication tags
verify --> actor : Success or identified packaging failure
@enduml
