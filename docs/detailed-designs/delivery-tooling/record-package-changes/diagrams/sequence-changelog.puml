@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
 BorderColor #344054
 FontColor #101828
}
skinparam package {
 BorderColor #667085
 FontColor #101828
 BackgroundColor #F9FAFB
}
skinparam maxMessageSize 80
title Behavior - Render changelog attribution
actor "Maintainer" as actor
box "Backend - Local tooling process (not a service)" #FFF4E5
participant "Beachball change record" as change
participant "SharedConfig" as config
participant "renderHeader" as header
participant "renderEntry" as entry
end box
actor -> config : Select scoped release configuration [L2-035]
config -> header : Render version/date header
header --> config : Markdown header
config -> entry : Render changelog entry
entry -> change : Read comment and source metadata
change --> entry : Recorded release intent
entry --> config : Markdown with PR/commit attribution
config --> actor : Changelog output
note over config : Diagram describes pipeline; no release is performed
@enduml
