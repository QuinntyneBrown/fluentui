@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()
title Containers - Render and hydrate controls
Person(actor, "Application user", "Uses or reviews the feature")
System_Boundary(system, "Fluent UI consuming application") {
Container(browser, "Consumer browser application", "JavaScript / DOM", "Hosts Fluent UI libraries in the same process")
Container(server, "Consumer server renderer", "Node / React DOM server", "Produces provider and control markup")
}
Rel(actor, browser, "Uses")
Rel(server, browser, "Supplies HTML for hydration")
@enduml
