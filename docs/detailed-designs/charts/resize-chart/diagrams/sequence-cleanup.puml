@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
 BorderColor #344054
 FontColor #101828
}
skinparam package {
 BorderColor #667085
 FontColor #101828
 BackgroundColor #F9FAFB
}
skinparam maxMessageSize 80
title Behavior - Dispose resize resources
actor "Application user" as actor
box "Frontend - Consumer browser application" #E0F2FE
participant "ResponsiveContainer" as container
participant "ResizeObserver" as observer
participant "Window animation frame" as frame
participant "ResponsiveChildProps" as child
end box
actor -> container : Unmount [L2-044]
container -> frame : Cancel tracked pending frame
frame --> container : Tracked callback canceled
container -> observer : disconnect()
observer --> container : Observation removed
container --> actor : Lifecycle disposed
@enduml
