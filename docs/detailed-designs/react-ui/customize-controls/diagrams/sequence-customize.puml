@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
 BorderColor #344054
 FontColor #101828
}
skinparam package {
 BorderColor #667085
 FontColor #101828
 BackgroundColor #F9FAFB
}
skinparam maxMessageSize 80
title Behavior - Resolve customized slots and classes
actor "Application user" as actor
box "Frontend - Consumer browser application" #E0F2FE
participant "Button / Input" as entry
participant "slot.always / slot.optional" as slots
participant "useButtonStyles_unstable" as styles
participant "assertSlots / renderButton_unstable" as render
end box
actor -> entry : Supply icon/content, className, and ref [L2-005]
entry -> slots : Normalize required and optional slots
slots --> entry : Typed slot state
entry -> styles : Apply style hook [L2-006]
styles --> entry : State with merged classes
entry -> render : assertSlots and render
render --> actor : Customized element with forwarded ref
@enduml
