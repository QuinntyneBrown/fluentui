@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
 BorderColor #344054
 FontColor #101828
}
skinparam package {
 BorderColor #667085
 FontColor #101828
 BackgroundColor #F9FAFB
}
skinparam maxMessageSize 80
title Behavior - Evaluate documented accessibility
actor "Application user" as actor
box "Frontend - Consumer browser application" #E0F2FE
participant "ButtonAccessibility contract" as spec
participant "ComponentTestFacade" as facade
participant "validateBehavior" as checks
participant "Button" as button
end box
actor -> spec : Select component accessibility contract [L2-011]
spec --> actor : Roles, names, commands, and focus destinations
actor -> checks : Validate behavior definition
checks -> facade : Request rendered behavior
facade -> button : Render and interact
button --> facade : Semantics and focus
facade --> checks : Observed behavior
checks --> actor : Errors or satisfied checks
@enduml
