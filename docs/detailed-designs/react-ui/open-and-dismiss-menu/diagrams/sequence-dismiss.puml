@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
 BorderColor #344054
 FontColor #101828
}
skinparam package {
 BorderColor #667085
 FontColor #101828
 BackgroundColor #F9FAFB
}
skinparam maxMessageSize 80
title Behavior - Dismiss popup and restore focus
actor "Application user" as actor
box "Frontend - Consumer browser application" #E0F2FE
participant "useMenuBase_unstable" as menu
participant "usePositioning" as position
participant "useMenuPopover_unstable" as popover
participant "Portal" as portal
end box
actor -> popover : Escape inside open popup [L2-043]
popover -> menu : setOpen(event, { open: false, keyboard: true })
menu --> popover : Closed context
popover -> portal : Unmount after supported motion lifecycle
portal --> popover : Popup removed
popover --> actor : Focus-restoration behavior returns to trigger
note over popover : Actual focus result requires acceptance execution
@enduml
