@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
 BorderColor #344054
 FontColor #101828
}
skinparam package {
 BorderColor #667085
 FontColor #101828
 BackgroundColor #F9FAFB
}
skinparam maxMessageSize 80
title Behavior - Activate or suppress action
actor "Application user" as actor
box "Frontend - Consumer browser application" #E0F2FE
participant "Button" as entry
participant "useButton_unstable" as state
participant "useARIAButtonProps" as aria
participant "renderButton_unstable" as view
end box
actor -> aria : Click normalized root [L2-010]
alt Enabled
aria --> actor : Invoke consumer onClick [L2-001]
else Disabled or focusable-disabled
note over aria : Native disabled handling or omitted handlers prevent action
aria --> actor : No consumer callback
end
note over aria : Native focusable-disabled roots retain tab focus
@enduml
