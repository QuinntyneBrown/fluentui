@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()
title Components - Edit Input
Container_Boundary(feature_scope, "Consumer browser application") {
Component(entry, "Input", "React component", "Composes input state and rendering")
Component(state, "useInputBase_unstable", "State hook", "Partitions native props and handles onChange")
Component(value, "useControllableState", "Utility hook", "Chooses controlled or internal state")
