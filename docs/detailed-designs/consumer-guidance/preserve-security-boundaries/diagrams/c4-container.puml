@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()
title Containers - Preserve security boundaries
Person(actor, "Application user", "Uses or reviews the feature")
System_Boundary(system, "Fluent UI consuming application") {
Container(browser, "Consumer browser application", "JavaScript / DOM", "Hosts Fluent UI libraries in the same process")
}
Rel(actor, browser, "Uses")
Container(process, "Local schema validation process", "Node / Ajv", "Validates tooling configuration independently of browser UI")
ContainerDb(policyfiles, "Repository policy files", "Markdown files", "Private reporting instructions")
Rel(actor, process, "Validates tool configuration")
Rel(actor, policyfiles, "Reads policy")
@enduml
