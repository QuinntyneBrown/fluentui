@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
 BorderColor #344054
 FontColor #101828
}
skinparam package {
 BorderColor #667085
 FontColor #101828
 BackgroundColor #F9FAFB
}
skinparam maxMessageSize 80
title Behavior - Validate library-owned configuration
actor "Application user" as actor
box "Frontend - Consumer browser application" #E0F2FE
participant "renderButton_unstable" as button
participant "useInputBase_unstable" as input
participant "Consumer authorization boundary" as host
end box
box "Backend - Local tooling process (not a service)" #FFF4E5
participant "loadConfig" as config
end box
box "Frontend - Repository policy documentation" #E0F2FE
participant "SECURITY.md" as policy
end box
actor -> config : Supply isolation JSON input [L2-040]
config -> config : Ajv schema validation
alt Invalid or globbed allowed violation
config --> actor : Configuration error without PASS
else Valid structure
config --> actor : Validated Config
end
@enduml
